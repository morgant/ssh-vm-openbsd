# defaults
tap_vm_subnet="100.64"  # see vmctl(8), esp. the "LOCAL INTERFACES" section
tap_vm_guest_offset=3

_fatal() {
  printf "%s: %s Exiting.\n" "$(basename "$0")" "$1" >&2
  exit $2
}

_vm_id_for_name() {
  _status="$(vmctl status "$1" | head -n 2 | tail -n 1)"
  _id="$(echo "$_status" | awk '{ print $1 }')"
  [ -n "$_id" ] && [ "$_id" != "ID" ] \
    && printf "%i" "$_id"
}

_is_vm_running() {
  _status="$(vmctl status -r "$1" | head -n 2 | tail -n 1)"
  _id="$(echo "$_status" | awk '{ print $1 }')"
  [ -n "$_id" ] && [ "$_id" != "ID" ]
}

_vm_subnet_for_id() {
  printf "%s.%i" "$tap_vm_subnet" "$1"
}

_vm_ip_for_id() {
  _if_num="${2:-0}"
  printf "%s.%i" \
    "$(_vm_subnet_for_id "$1")" \
    "$(( _if_num + tap_vm_guest_offset ))"
}

_ping_vm_for_id() {
  _if_num="${2:-0}"
  _if_ip="$(_vm_ip_for_id "$1" "$_if_num")"
  ping -qc 1 "$_if_ip" >/dev/null
}
