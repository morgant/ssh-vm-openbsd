# defaults
tap_vm_subnet="100.64"  # see vmctl(8), esp. the "LOCAL INTERFACES" section
tap_vm_guest_offset=3

_fatal() {
  printf "%s: %s Exiting.\n" "$(basename "$0")" "$1" >&2
  exit $2
}

_vm_subnet_for_id() {
  printf "%s.%i" "$tap_vm_subnet" "$1"
}

_vm_ip_for_id() {
  _if_num="${2:-0}"
  printf "%s.%i" \
    "$(_vm_subnet_for_id "$1")" \
    "$(( _if_num + tap_vm_guest_offset ))"
}

_ping_vm_for_id() {
  _if_num="${2:-0}"
  _if_ip="$(_vm_ip_for_id "$1" "$_if_num")"
  ping -qc 1 "$_if_ip" >/dev/null
}

# require an argument containing a VM name or numerical ID
[ -z "$1" ] && _fatal "VM id or name required!" 2

# default to $USER if no '<user>@' included in the VM name/ID
target_user="${1%%@*}"
if [ "$target_user" != "$1" ] ; then
  target_vm="${1#*@}"
else
  target_user="$USER"
  target_vm="$1"
fi

# vmd must be running
! rcctl -q check vmd && _fatal "vmd is not running!"

# require a running VM with a matching & valid name or numerical ID
vmctl_status="$(vmctl status -r "$target_vm" | head -n 2 | tail -n 1)"
vm_id="$(echo "$vmctl_status" | awk '{ print $1 }')"
vm_name="$(echo "$vmctl_status" | awk '{ print $9 }')"
[ -z "$vm_id" ] || [ "$vm_id" = "ID" ] \
  || [ -z "$vm_name" ] || [ "$vm_name" = "NAME" ] \
  && _fatal "VM '${target_vm}' does not appear to be running!"

# send a single ping the VM guest tap(4) interface
! _ping_vm_for_id "$vm_id" && _fatal "Could not ping VM '${vm_name}'!"

# initiate the ssh connection
exec ssh "${target_user}@$(_vm_ip_for_id "$vm_id")"
